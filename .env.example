# URL pubblico del sito (canonical, sitemap, Open Graph). Senza slash finale.
NEXT_PUBLIC_SITE_URL=https://www.dominio-villa-san-carlo.it

# Invio del modulo contatti tramite Resend (https://resend.com) — solo lato server.
RESEND_API_KEY=
# Destinatario delle richieste (più indirizzi separati da virgola)
CONTACT_TO_EMAIL=
# Mittente su un dominio verificato in Resend, es. "Villa San Carlo <sito@dominio.it>"
CONTACT_FROM_EMAIL=
